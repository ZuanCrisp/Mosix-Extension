{
  "name": "genie-music",
  "displayName": "Genie Music",
  "version": "2.0.5",
  "description": "Genie Music track and album metadata, paginated artist catalogs, charts, and URL imports",
  "author": "custom",
  "homepage": "https://github.com/ldw0403-netizen/K-Music",
  "permissions": {
    "network": [
      "www.genie.co.kr",
      "genie.co.kr"
    ],
    "storage": false,
    "file": false
  },
  "type": [
    "metadata_provider"
  ],
  "icon": "icon.png",
  "capabilities": {
    "homeFeed": true
  },
  "searchBehavior": {
    "enabled": true,
    "primary": false,
    "placeholder": "ì§€ë‹ˆë®¤ì§ ê²€ìƒ‰...",
    "thumbnailRatio": "square"
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "genie.co.kr/detail/songInfo",
      "genie.co.kr/detail/albumInfo",
      "genie.co.kr/detail/artistInfo"
    ]
  },
  "skipMetadataEnrichment": false,
  "skipBuiltInFallback": false
}
