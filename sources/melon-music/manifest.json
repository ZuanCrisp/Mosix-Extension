{
  "name": "melon-music",
  "displayName": "Melon Music",
  "version": "2.0.5",
  "description": "Melon Music metadata provider with charts, album and artist catalogs, DJ playlists, and URL imports",
  "author": "custom",
  "homepage": "https://github.com/ldw0403-netizen/K-Music",
  "permissions": {
    "network": [
      "www.melon.com",
      "melon.com",
      "m2.melon.com",
      "m.app.melon.com"
    ],
    "storage": false,
    "file": false
  },
  "type": [
    "metadata_provider"
  ],
  "icon": "icon.png",
  "capabilities": {
    "homeFeed": true
  },
  "searchBehavior": {
    "enabled": true,
    "primary": false,
    "placeholder": "ë©œë¡ ë®¤ì§ ê²€ìƒ‰...",
    "thumbnailRatio": "square"
  },
  "skipMetadataEnrichment": false,
  "skipBuiltInFallback": false,
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "melon.com/song/detail.htm",
      "melon.com/album/detail.htm",
      "melon.com/artist/detail.htm",
      "melon.com/artist/timeline.htm",
      "melon.com/artist/song.htm",
      "melon.com/artist/album.htm",
      "melon.com/landing/playList.htm",
      "melon.com/mymusic/dj/mymusicdjplaylistview_inform.htm"
    ]
  }
}
